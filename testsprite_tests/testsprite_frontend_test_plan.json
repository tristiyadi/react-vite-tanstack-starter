[
  {
    "id": "TC001",
    "title": "Password confirmation mismatch shows validation error",
    "description": "Verifies the registration form blocks submission when password confirmation does not match the password.",
    "category": "User Registration",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /register"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Create account\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Mismatch User\" into the name field"
      },
      {
        "type": "action",
        "description": "Type \"mismatch.user+e2e@example.com\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"MismatchPass123!\" into the password field"
      },
      {
        "type": "action",
        "description": "Type \"DifferentPass123!\" into the password confirmation field"
      },
      {
        "type": "action",
        "description": "Click \"Create account\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Passwords do not match\" is visible"
      }
    ]
  },
