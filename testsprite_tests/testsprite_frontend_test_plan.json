  {
    "id": "TC007",
    "title": "Access admin user management and view the user list",
    "description": "Verifies an authenticated admin can open User Management and see the users list page.",
    "category": "User Management (Admin)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      },
      {
        "type": "action",
        "description": "Click \"Users\" in the admin navigation"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Users\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Add User\" is visible"
      }
    ]
  },
  {
    "id": "TC008",
    "title": "Create a new user from the Users page",
    "description": "Verifies an admin can add a new user and see it appear in the users list.",
    "category": "User Management (Admin)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign in\" button"
      },
      {
        "type": "action",
        "description": "Click \"Users\" in the admin navigation"
      },
      {
        "type": "action",
        "description": "Click the \"Add User\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Add User\" is visible"
      },
      {
        "type": "action",
        "description": "Fill \"Test User A\" into the name field"
      },
      {
        "type": "action",
        "description": "Fill \"test.user.a+e2e@example.com\" into the email field"
      },
      {
        "type": "action",
        "description": "Fill \"testuser_a_e2e\" into the username field"
      },
      {
        "type": "action",
        "description": "Select \"User\" from the role dropdown"
      },
      {
        "type": "action",
        "description": "Select \"Active\" from the status dropdown"
      },
      {
        "type": "action",
        "description": "Fill \"TempPass!234\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Submit\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"test.user.a+e2e@example.com\" is visible"
      }
    ]
  },
